# Somente no worker. Nunca use VITE_ para segredos nem a chave de produção.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
CREATIVE_VISION_MODEL=gpt-4.1-mini
CREATIVE_TRANSCRIPTION_MODEL=whisper-1
CREATIVE_META_VERSION=v21.0
# Coleta externa permanece desabilitada até homologação específica.
CREATIVE_ENABLE_APIFY=false
CREATIVE_ENABLE_APIFY_TIKTOK=false
APIFY_API_TOKEN=
