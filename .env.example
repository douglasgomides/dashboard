# Navegador: estes dois valores são públicos e entram no bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Domínio curto dos links rastreados mostrado e copiado na tela (padrão https://dash.doctorcreator.com.br).
VITE_LINK_BASE_URL=

# Servidor: nunca usar prefixo VITE_ nestas credenciais.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SYNC_SECRET=
# Domínio curto dos links rastreados devolvido pela API (mesmo valor do VITE_LINK_BASE_URL; o domínio precisa apontar
# para este projeto, que atende /r/<nome>).
LINK_BASE_URL=

# Opcionais; preencher somente para as integrações usadas no ambiente.
WINDSOR_API_KEY=
META_ACCESS_TOKEN=
META_ADS_TOKEN=
WTS_API_TOKEN=
KOMMO_API_TOKEN=
SHORTIO_API_KEY=
SHORTIO_DOMAIN=
CLICKUP_API_TOKEN=

# IA: pode usar um dos provedores disponíveis. Não é necessária nos testes.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Janela padrão do script local de sincronização.
SYNC_DAYS=90
