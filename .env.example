# Supabase — client-side (safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server-side only (sync script, server routes). NEVER expose to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Windsor.ai — server-side only. Used by scripts/sync-instagram.ts.
WINDSOR_API_KEY=

# How many days back to sync on each run (default 90).
SYNC_DAYS=90
